# =====================================================================
# Disaster Response Intelligence Platform — Environment Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE — core backend (Auth, Postgres+PostGIS, pgvector, Storage, Realtime)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role (server-side ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prisma connection pair (Prisma requires BOTH when directUrl is set)
# DATABASE_URL  = Supabase transaction-pooler (serverless, port 6543)
# DIRECT_URL    = direct connection for prisma migrate / studio (port 5432)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# WEATHER & HYDROLOGY — live ingestion pipeline
# ---------------------------------------------------------------------
# OpenWeatherMap current weather -> rainfall (mm). https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweathermap-api-key

# GLOFAS (ECMWF) global flood forecasts. Free, registration required:
# https://cds.climate.copernicus.eu  -> create an API token
GLOFAS_CDS_API_KEY=your-glofas-cds-api-key

# ---------------------------------------------------------------------
# SATELLITE & EARTH OBSERVATION — flood extent validation
# ---------------------------------------------------------------------
# NASA POWER (historical rainfall/temp, no key required) — free tier key optional:
# https://power.larc.nasa.gov/docs/v1/
NASA_API_KEY=your-nasa-api-key

# Google Earth Engine — service-account JSON downloaded from your GEE project.
GEE_SERVICE_ACCOUNT_JSON=your-google-earth-engine-service-account.json

# Sentinel Hub (Sentinel-1 SAR / Sentinel-2 optical) — free tier: https://www.sentinel-hub.com
SENTINELHUB_CLIENT_ID=your-sentinelhub-client-id
SENTINELHUB_CLIENT_SECRET=your-sentinelhub-client-secret

# ---------------------------------------------------------------------
# MULTI-HAZARD DATA SOURCES — earthquake / cyclone / wildfire / tsunami
# ---------------------------------------------------------------------

# EARTHQUAKE — USGS FDSN event + GeoJSON feed (free, NO key required):
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

# TROPICAL CYCLONE / HURRICANE / TYPHOON:
NOAA_NHC_API_TOKEN=your-noaa-nhc-token-optional
GDACS_CYCLONE_URL=https://www.gdacs.org/xml/rss_cyclone.xml

# WILDFIRE:
# NASA FIRMS (MODIS/VIIRS active-fire hotspots) — free key: https://firms.modaps.eosdis.nasa.gov/
FIRMS_API_KEY=your-nasa-firms-api-key
GWIS_API_URL=https://gwis.jrc.ec.europa.eu/apps/gwis.api/

# TSUNAMI:
NOAA_PTWC_FEED_URL=https://www.tsunami.gov/events/PAAQ/PAAQ.xml

# GLOBAL MULTI-HAZARD EVENT FEEDS (situation awareness, free, no key):
EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events
GDACS_ALERTS_URL=https://www.gdacs.org/xml/rss.xml

# ---------------------------------------------------------------------
# INDIA HYDROLOGY — IMD + CWC (high-value for the demo district)
# ---------------------------------------------------------------------

# IMD API Management platform (real-time rain, QPF, forecasts, warnings).
IMD_API_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=your-imd-api-key

# CWC river data via the National Water Data Portal (NWIC) — 532 ready APIs
CWC_NWDP_API_URL=https://nwdp.nwic.gov.in
CWC_NWDP_API_KEY=your-nwdp-api-key-optional

# Open Government Data (OGD) — India-wide public datasets (rainfall, floods)
DATA_GOVIN_API_KEY=your-data-gov-in-api-key

# ---------------------------------------------------------------------
# EVACUATION & ROUTING (opt-in) — for the Evacuation-Planner phases
# ---------------------------------------------------------------------
# OSRM — free public routing server (turn-by-turn + polylines, no key).
OSRM_PUBLIC_URL=https://router.project-osrm.org

# GraphHopper — directions + VRP (vehicle routing, the rescue-assignment solver).
GRAPHHOPPER_API_URL=https://graphhopper.com/api/1
GRAPHHOPPER_API_KEY=your-graphhopper-api-key

# openrouteservice — directions / isochrones / POIs (free daily quota).
OPENROUTE_API_URL=https://api.openrouteservice.org
OPENROUTE_API_KEY=your-openroute-api-key

# ---------------------------------------------------------------------
# POPULATION & CRISIS DATA — affected-population + shelters + baseline
# ---------------------------------------------------------------------
# WorldPop REST API — high-res population & age/sex within a GeoJSON polygon.
WORLDPOP_API_URL=https://api.worldpop.org/v1
WORLDPOP_API_KEY=your-api-worldpop-api-key

# HDX (Humanitarian Data Exchange / OCHA) — shelters, demographics, baseline population.
HDX_API_URL=https://data.humdata.org/api
HDX_API_TOKEN=your-hdx-api-token
HDX_HAPI_URL=https://hapi.humdata.org
HDX_HAPI_APP_IDENTIFIER=your-base64-app-identifier

# ---------------------------------------------------------------------
# GEOCODING + ELEVATION — reverse-geocode the map focus -> district
# ---------------------------------------------------------------------
# OpenCage Geocoding — forward + reverse (free 2500/day).
OPENCAGE_API_KEY=your-opencage-api-key
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Open Topo Data — free SRTM elevation (1 req/sec, 1000/day).
OPENTOPODATA_API_URL=https://api.opentopodata.org/v1/srtm90m

# Air quality (post-flood / dust health monitoring) — keyless:
OPENAQ_API_URL=https://api.openaq.org/v2

# ---------------------------------------------------------------------
# LLM / AI ORCHESTRATION — multi-agent planner + RAG + chat
# ---------------------------------------------------------------------
# Groq — fast open-weight LLMs (fallback router)
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_BACKUP=your-groq-backup-api-key

# OpenRouter — unified LLM gateway (200+ models)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_KEY_BACKUP=your-openrouter-backup-api-key

# Bluesminds — free tier: daily pi credits, no credit card
BLUESMINDS_API_KEY=your-bluesminds-api-key

# Web search / news (for situational awareness widget)
SERPAPI_API_KEY=your-serpapi-api-key
NEWSDATA_API_KEY=your-newsdata-api-key

# ---------------------------------------------------------------------
# DOCUMENTS & RAG SOURCES (SOPs / NDMA guidelines / district DMPs)
# ---------------------------------------------------------------------
# Notion — index pages/databases of emergency docs
NOTION_TOKEN=your-notion-token
NOTION_DATABASE_ID=your-notion-database-id

# Hugging Face — optional: hosted embedding / segmentation models
HF_TOKEN=your-huggingface-token

# Web scraping (for ingesting NDMA/CWC/IMD pages into the knowledge base)
CRAWL4AI_API_KEY=your-crawl4ai-api-key
CRAWL4AI_BASE_URL=https://api.crawl4ai.com

# ---------------------------------------------------------------------
# ALERTS & NOTIFICATIONS — SMS / push / in-app
# ---------------------------------------------------------------------
# Twilio — SMS flood alerts to field responders (free trial credits)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-from-number

# Web Push — VAPID keys for free browser notifications (web-push-libs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:team@disaster-response.in

# Novu — multi-channel notification infrastructure (in-app feed + email + SMS)
NOVU_API_KEY=your-novu-api-key
NOVU_APPLICATION_ID=your-novu-application-id

# ---------------------------------------------------------------------
# MISC / APP CONFIG
# ---------------------------------------------------------------------
# Public site URL — used by server-side fetchers to call internal routes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron auth — lock /api/cron/ingest behind a bearer token.
CRON_SECRET=your-cron-secret-here

# Python FastAPI ML microservice (ml_service/) — used by lib/ml-client.ts.
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional country-meta provider (kept for legacy widgets)
REST_COUNTRIES_API_KEY=your-rest-countries-api-key

# ---------------------------------------------------------------------
# FM RADIO EMERGENCY BROADCASTING - AI alert voice (Phase 2, TTS)
# Chain: ElevenLabs (primary) -> Azure Neural (fallback) -> Google Cloud.
# Audio is stored in the Supabase `alert-audio` bucket when available.
# ---------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional per-language voice override (defaults are Indian-accented).
ELEVENLABS_VOICE_ID=

# Azure Speech (neural voices: hi-IN-MadhurNeural, bn-IN-TanishaaNeural, ...)
AZURE_TTS_KEY=your-azure-speech-key
AZURE_TTS_REGION=centralindia

# Google Cloud TTS (emergency fallback)
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# ---------------------------------------------------------------------
# FM RADIO EMERGENCY BROADCASTING - FM dispatcher (Phase 4)
# Shared bearer token sent to station CAP/RDS APIs.
FM_BROADCAST_TOKEN=your-fm-broadcast-token

# Strategy C (FTP drop) - shared FTP drop for stations without per-station
# ftp:// URLs on emergency_api_endpoint.
FM_FTP_HOST=your-ftp-host
FM_FTP_PORT=21
FM_FTP_USER=anonymous
FM_FTP_PASSWORD=

# Strategy D (Email to studio) - SMTP for the emergency inbox fallback.
FM_SMTP_HOST=
FM_SMTP_PORT=587
FM_SMTP_SECURE=false
FM_SMTP_USER=
FM_SMTP_PASS=
FM_SMTP_FROM=disasterlink@ddma.gov.in
# Fallback inbox when a station has no email_address set.
FM_EMAIL_TO=
