<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/borderSubtle"
    app:strokeWidth="1dp"
    style="@style/Widget.SafeSphere.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/opPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Operation Plan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/opDistrict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Patna"
                android:textSize="12sp"
                android:textColor="@color/textSecondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/opPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="CRITICAL"
                style="@style/Widget.SafeSphere.Chip.Critical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/opStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                style="@style/Widget.SafeSphere.Chip.Critical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/opAssets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="14 units"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:gravity="center" />

            <TextView
                android:id="@+id/opOwner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="R. Verma"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:gravity="center" />

            <TextView
                android:id="@+id/opUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2m ago"
                android:textSize="11sp"
                android:textColor="@color/textMuted"
                android:gravity="end" />

        </LinearLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>