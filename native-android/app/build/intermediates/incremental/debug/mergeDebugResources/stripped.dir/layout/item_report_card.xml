<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/borderSubtle"
    app:strokeWidth="1dp"
    style="@style/Widget.SafeSphere.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@color/colorPrimary"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reportType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLOODING"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reportSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Severity 90"
                style="@style/Widget.SafeSphere.Chip.Critical" />

        </LinearLayout>

        <TextView
            android:id="@+id/reportLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kankarbagh, Patna"
            android:textSize="13sp"
            android:textColor="@color/textSecondary" />

        <TextView
            android:id="@+id/reportText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Report text here"
            android:textSize="13sp"
            android:textColor="@color/textPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/reportSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="social"
                android:textSize="11sp"
                android:textColor="@color/textMuted"
                android:background="@color/bgSurface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View
                android:id="@+id/reportPwdBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@color/colorInfo"
                android:paddingHorizontal="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reportPwdDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Requires Accessible Rescue"
                android:textSize="10sp"
                android:textColor="@color/colorInfo"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <Button
                android:id="@+id/reportVerify"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Verify"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.SafeSphere.Button.Success" />

            <Button
                android:id="@+id/reportReject"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Reject"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.SafeSphere.Button.Danger" />

            <Button
                android:id="@+id/reportDrone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Drone"
                android:textSize="12sp"
                android:textAllCaps="false"
                style="@style/Widget.SafeSphere.Button.Primary" />

        </LinearLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>