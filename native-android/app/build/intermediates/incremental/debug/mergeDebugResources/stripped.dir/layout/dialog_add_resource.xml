<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Resource Name" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <android.widget.Spinner
            android:id="@+id/resCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resUnitInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (e.g., units, kits, pallets)" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resDepotInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Depot Name" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>