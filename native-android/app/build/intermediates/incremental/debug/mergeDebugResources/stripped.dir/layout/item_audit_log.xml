<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/borderSubtle"
    app:strokeWidth="1dp"
    style="@style/Widget.SafeSphere.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/auditSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="INFO"
                style="@style/Widget.SafeSphere.Chip.Info" />

            <TextView
                android:id="@+id/auditAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTION_NAME"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:fontFamily="monospace" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/auditActor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="actor@domain"
                android:textSize="12sp"
                android:textColor="@color/textSecondary" />

            <TextView
                android:id="@+id/auditResource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="resource"
                android:textSize="12sp"
                android:textColor="@color/textMuted" />

            <TextView
                android:id="@+id/auditIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="192.168.1.1"
                android:textSize="11sp"
                android:textColor="@color/textMuted"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/auditTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Jan 15, 14:30"
                android:textSize="11sp"
                android:textColor="@color/textMuted" />

        </LinearLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>