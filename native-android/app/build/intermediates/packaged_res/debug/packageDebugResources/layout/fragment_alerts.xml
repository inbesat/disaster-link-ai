<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgSecondary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/alerts_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/nav_alerts"
            style="@style/Widget.SafeSphere.Toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/composeAlertBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Compose Alert"
                android:icon="@drawable/ic_add"
                style="@style/Widget.SafeSphere.Button.Primary" />

            <androidx.appcompat.widget.SearchView
                android:id="@+id/alertSearchView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:queryHint="Search alerts..." />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/alertFilterChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:paddingTop="0dp"
            app:singleSelection="true"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCritical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/severity_critical"
                style="@style/Widget.SafeSphere.Chip.Critical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/severity_warning"
                style="@style/Widget.SafeSphere.Chip.Warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/severity_info"
                style="@style/Widget.SafeSphere.Chip.Info" />

        </com.google.android.material.chip.ChipGroup>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alertsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabComposeAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Compose Alert" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>