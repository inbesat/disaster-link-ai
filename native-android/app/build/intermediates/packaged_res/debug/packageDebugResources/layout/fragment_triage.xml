<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgSecondary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/triage_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/nav_triage"
            style="@style/Widget.SafeSphere.Toolbar" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/triageFilterChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:paddingTop="0dp"
            app:singleSelection="true"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterCritical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Critical"
                style="@style/Widget.SafeSphere.Chip.Critical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterFlooding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flooding"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterRoadBlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Road Blocked"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterShelterNeeded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shelter Needed"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filterRescue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rescue"
                style="@style/Widget.SafeSphere.Chip" />

        </com.google.android.material.chip.ChipGroup>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/triageRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>