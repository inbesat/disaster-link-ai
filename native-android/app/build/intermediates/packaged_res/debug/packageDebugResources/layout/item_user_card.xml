<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/borderSubtle"
    app:strokeWidth="1dp"
    style="@style/Widget.SafeSphere.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/userInitials"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/bgSurface"
            android:gravity="center"
            android:text="RK"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorWarning"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/userEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="user@org.in"
                android:textSize="12sp"
                android:textColor="@color/textMuted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/userOrg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Organization"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/userDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patna"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/userRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTRICT_ADMIN"
                style="@style/Widget.SafeSphere.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/userStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ACTIVE"
                style="@style/Widget.SafeSphere.Chip.Success" />

            <TextView
                android:id="@+id/userLastActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2m ago"
                android:textSize="11sp"
                android:textColor="@color/textMuted" />

            <Button
                android:id="@+id/userAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:text="Deactivate"
                android:textSize="11sp"
                android:textAllCaps="false"
                style="@style/Widget.SafeSphere.Button.Secondary" />

        </LinearLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>