<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgSecondary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/agent_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/nav_agent_orchestration"
            app:subtitle="LANGGRAPH MULTI-AGENT"
            style="@style/Widget.SafeSphere.Toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Incident Input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.SafeSphere.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCIDENT DETAILS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.SafeSphere.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/incidentInput"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:hint="Describe the incident..."
                            android:inputType="textMultiLine"
                            android:gravity="top" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="end">

                        <Button
                            android:id="@+id/simulateBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:text="Simulate Level 4 Crisis"
                            style="@style/Widget.SafeSphere.Button.Secondary" />

                        <Button
                            android:id="@+id/runBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Run Orchestration"
                            android:icon="@drawable/ic_play"
                            style="@style/Widget.SafeSphere.Button.Primary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Agent Pipeline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="AGENT PIPELINE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textMuted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/agentPipelineRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Status Cards -->
            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

            </LinearLayout>

            <!-- Decision Log -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="CHAIN OF REASONING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textMuted" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/decisionLogRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Replay Timeline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="REPLAY TIMELINE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textMuted" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                style="@style/Widget.SafeSphere.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageButton
                        android:id="@+id/replayPrev"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_nav_back"
                        android:background="@color/bgSurface"
                        android:contentDescription="Previous" />

                    <TextView
                        android:id="@+id/replayStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 3 of 5: Allocator - Resource allocation complete"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:gravity="center"
                        android:padding="16dp" />

                    <ImageButton
                        android:id="@+id/replayNext"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_nav_forward"
                        android:background="@color/bgSurface"
                        android:contentDescription="Next" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>