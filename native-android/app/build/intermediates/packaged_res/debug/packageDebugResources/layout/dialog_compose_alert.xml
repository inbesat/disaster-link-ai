<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alertDistrictInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="District" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alertMessageInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Alert Message"
            android:inputType="textMultiLine"
            android:gravity="top" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <android.widget.Spinner
            android:id="@+id/alertSeveritySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.SafeSphere.TextInputLayout">

        <android.widget.Spinner
            android:id="@+id/alertChannelSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>