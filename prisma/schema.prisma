// Prisma schema for the SafeSphere Platform
// Mirrors supabase/migrations/0001_initial_schema.sql exactly.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // Enable PostGIS + pgvector so the Unsupported() types below are recognised.
  extensions = [postgis, vector]
}

// ---------------------------------------------------------------------
// users
// Phase 1 · Dual-Mode: one User model serves Public (citizens) and Gov
// (responders/admins). `role` is a typed enum; new signups default to
// `public` and are promoted to responder/admin roles on approval.
// ---------------------------------------------------------------------
enum UserRole {
  public
  field_responder
  district_admin
  super_admin
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  name              String?
  role              UserRole @default(public)
  organization      String?
  phone             String?
  emergencyContact  Json?    @map("emergency_contact")
  district          String?
  assignedDistrict  String?  @map("assigned_district")
  homeDistrict      String?  @map("home_district") // citizen's home district (Phase 1)
  avatarUrl         String?  @map("avatar_url")
  preferredLanguage String   @default("en") @map("preferred_language") // Phase 25 · multilingual UI (aka language_preference)
  verificationIdUrl String?  @map("verification_id_url") // gov ID/verification document (Phase 1)
  isGuest           Boolean  @default(false) @map("is_guest") // guest/demo session flag (Phase 1)
  isApproved        Boolean  @default(true) @map("is_approved") // gov account approval gate (Phase 1)
  // Phase 13 · Step 4 — SMS fallback status. Citizens with no internet text
  // "SAFE" to the Twilio webhook; the status is persisted here so family
  // members and responders can see it (mirrors the in-app drip:i-am-safe
  // flow, which is per-browser localStorage only). Requires a migration:
  //   npx prisma migrate dev --name add_safety_status
  safetyStatus      String    @default("unknown") @map("safety_status")
  lastSafeAt        DateTime? @map("last_safe_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  familyContacts FamilyContact[]

  @@index([district]) // responder directory + district role scoping
  @@index([homeDistrict]) // citizen directory / district-scoped alerts
  @@map("users")
}

// ---------------------------------------------------------------------
// family_contacts (Phase 1 · Dual-Mode) — citizen-designated emergency
// contacts. A citizen registers next-of-kin here so alerts can reach their
// family even when the citizen cannot be reached directly.
// ---------------------------------------------------------------------
model FamilyContact {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("family_contacts")
}

// ---------------------------------------------------------------------
// disaster_events
// ---------------------------------------------------------------------
model DisasterEvent {
  id        String                                @id @default(uuid()) @db.Uuid
  name      String
  type      String                                @default("flood")
  status    String                                @default("monitoring")
  district  String?
  epicenter Unsupported("geometry(Point, 4326)")?
  startedAt DateTime?                             @map("started_at") @db.Timestamptz
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                              @updatedAt @map("updated_at") @db.Timestamptz
  isDemo    Boolean                              @default(false) @map("is_demo")
  sessionId String?                              @map("session_id")

  resourceAllocations ResourceAllocation[]
  alertLogs           AlertLog[]
  emergencyDocuments  EmergencyDocument[]
  emergencyPlans      EmergencyPlan[]
  capAlerts           CapAlert[]
  fmApprovalRequests  FmApprovalRequest[]

  @@index([district]) // RLS scoping + district dashboards
  @@map("disaster_events")
}

// ---------------------------------------------------------------------
// alert_rules_fm (Phase 7) — per-district FM broadcast automation rules.
// Evaluated by lib/broadcast/auto-trigger.ts when a prediction escalates:
// district 'all' = every district, disaster_type 'all' = every hazard.
// ---------------------------------------------------------------------
model AlertRuleFm {
  id                   String   @id @default(uuid()) @db.Uuid
  district             String // district name or 'all'
  disasterType         String   @map("disaster_type") // flood | cyclone | earthquake | heatwave | all
  triggerSeverity      String   @map("trigger_severity") // warning | critical
  autoBroadcast        Boolean  @default(false) @map("auto_broadcast")
  targetLanguages      String[] @default(["hi", "en"]) @map("target_languages")
  fmRadiusKm           Int      @default(50) @map("fm_radius_km")
  rdsEnabled           Boolean  @default(true) @map("rds_enabled")
  ivrFallbackEnabled   Boolean  @default(true) @map("ivr_fallback_enabled")
  isActive             Boolean  @default(true) @map("is_active")
  createdBy            String?  @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([district, disasterType])
  @@map("alert_rules_fm")
}

// ---------------------------------------------------------------------
// fm_approval_requests (Phase 7) — human-in-the-loop broadcast queue.
// Created when a rule has auto_broadcast=false (or the broadcast rate
// limit is hit); auto-approves after auto_approve_after_seconds.
// ---------------------------------------------------------------------
model FmApprovalRequest {
  id                      String         @id @default(uuid()) @db.Uuid
  disasterEventId         String?        @map("disaster_event_id") @db.Uuid
  disasterEvent           DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: SetNull)
  district                String
  disasterType            String         @map("disaster_type")
  severity                String // warning | critical
  message                 String // AI voice-preview script
  rdsText                 String         @map("rds_text")
  stationsCount           Int            @default(0) @map("stations_count")
  status                  String         @default("pending") // pending | approved | rejected
  autoApproveAfterSeconds Int            @default(180) @map("auto_approve_after_seconds")
  decidedBy               String?        @map("decided_by") @db.Uuid
  decidedAt               DateTime?      @map("decided_at") @db.Timestamptz
  capAlertId              String?        @map("cap_alert_id")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([disasterEventId])
  @@map("fm_approval_requests")
}

// ---------------------------------------------------------------------
// emergency_plans  (structured AI-generated emergency plan per disaster)
// ---------------------------------------------------------------------
model EmergencyPlan {
  id              String         @id @default(uuid()) @db.Uuid
  disasterEventId String?        @map("disaster_event_id") @db.Uuid
  disasterEvent   DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: Cascade)
  district        String?
  title           String
  content         String
  planJson        Json?          @map("plan_json")
  status          String         @default("draft") // draft | active | approved | completed
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  isDemo          Boolean        @default(false) @map("is_demo")
  sessionId       String?        @map("session_id")

  @@index([disasterEventId])
  @@index([status])
  @@map("emergency_plans")
}

// ---------------------------------------------------------------------
// flood_predictions  (ML output store — written by the FastAPI service)
//
// Phase 12 · Cross-Mode Data Bridge: a single table behind BOTH modes.
//   PUBLIC fields  — risk_level drives citizen-facing risk overlays.
//   GOV-ONLY fields — raw_model_output (full ML payload) + confidence_score
//   are filtered server-side; RLS policies (supabase/…/rls_policies) never
//   expose them to anon users.
// ---------------------------------------------------------------------
model FloodPrediction {
  id                  String   @id @default(uuid()) @db.Uuid
  lat                 Float
  lng                 Float
  predictionTimestamp DateTime @map("prediction_timestamp") @db.Timestamptz
  // ── Public-safe ─────────────────────────────────────────────────
  riskLevel String @map("risk_level")
  // ── Gov-only ────────────────────────────────────────────────────
  rawModelOutput   Json?  @map("raw_model_output") // raw ML tensor/JSON output
  confidenceScore  Float  @map("confidence_score") // model confidence 0–1
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo           Boolean  @default(false) @map("is_demo")
  sessionId        String?  @map("session_id")

  @@index([riskLevel, predictionTimestamp])
  @@index([predictionTimestamp]) // prediction history / time-series charts
  @@index([riskLevel]) // filter risk-level views + alert triggers
  @@map("flood_predictions")
}

// ---------------------------------------------------------------------
// shelters  (PostGIS geometry(Point, 4326) + denormalised lat/lng)
// Phase 12 · Cross-Mode Data Bridge: one table, two audiences — PUBLIC
// (name, location, capacity, occupancy, facilities) + GOV-ONLY
// (contact_person, phone, operational_notes), the latter withheld at the
// API/RLS layer. Facilities stay public so citizens can pick a shelter
// by the amenities it offers.
// ---------------------------------------------------------------------
model Shelter {
  id               String                                @id @default(uuid()) @db.Uuid
  name             String
  district         String?
  lat              Float
  lng              Float
  capacity         Int
  currentOccupancy Int                                   @default(0) @map("current_occupancy")
  facilities       Json?                                 // { water, food, medical }
  operationalNotes String?                               @map("operational_notes") // gov-only comms/logs
  status           String                                @default("open")
  contactPerson    String?                               @map("contact_person")
  phone            String?
  imageUrl         String?                               @map("image_url")
  location         Unsupported("geometry(Point, 4326)")?
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                              @updatedAt @map("updated_at") @db.Timestamptz
  isDemo           Boolean                               @default(false) @map("is_demo")
  sessionId        String?                               @map("session_id")
  evacuationPlans  EvacuationPlan[]

  @@index([district]) // nearest-shelter + district-scoped queries
  @@map("shelters")
}

// ---------------------------------------------------------------------
// resources  (Phase 12 · Resource Inventory)
// ---------------------------------------------------------------------
model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  category  String   @default("other") // boat | food | medical | personnel | water | vehicle | communication | power | other
  quantity  Int      @default(0)
  unit      String? // pieces | kits | teams | boats | pallets ...
  lat       Float
  lng       Float
  status    String   @default("available") // available | deployed | maintenance
  depotName String?  @map("depot_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  isDemo   Boolean  @default(false) @map("is_demo")
  sessionId String? @map("session_id")

  resourceAllocations ResourceAllocation[]

  @@index([category, status]) // inventory filtering + dispatch matching
  @@map("resources")
}

// ---------------------------------------------------------------------
// resource_requests  (Phase 12 · field requests for supplies/teams)
// ---------------------------------------------------------------------
model ResourceRequest {
  id             String   @id @default(uuid()) @db.Uuid
  requestedBy    String   @map("requested_by")
  category       String
  quantityNeeded Int      @map("quantity_needed")
  urgency        String   @default("low") // low | high | critical
  lat            Float
  lng            Float
  status         String   @default("pending") // pending | approved | fulfilled
  notes          String   @default("") // voice-dictated / typed field notes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  isDemo         Boolean  @default(false) @map("is_demo")
  sessionId      String?  @map("session_id")

  @@index([status]) // pending-request queue on the dispatch console
  @@map("resource_requests")
}

// ---------------------------------------------------------------------
// resource_movements (Phase 12) — immutable trail of where resources went:
// depot → disaster site, with timestamps. Appended on dispatch and by the
// Record Movement form; denormalised `resource_name` keeps the trail readable
// even if the resource row is later deleted.
// ---------------------------------------------------------------------
model ResourceMovement {
  id           String   @id @default(uuid()) @db.Uuid
  resourceId   String?  @map("resource_id") @db.Uuid
  resourceName String   @map("resource_name")
  action       String // dispatched | delivered | returned | adjusted
  fromLabel    String?  @map("from_label")
  toLabel      String   @map("to_label")
  toLat        Float    @map("to_lat")
  toLng        Float    @map("to_lng")
  quantity     Int      @default(0)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo       Boolean  @default(false) @map("is_demo")
  sessionId    String?  @map("session_id")

  @@index([resourceId])
  @@index([action, createdAt])
  @@map("resource_movements")
}

// ---------------------------------------------------------------------
// resource_allocations
// ---------------------------------------------------------------------
model ResourceAllocation {
  id                String    @id @default(uuid()) @db.Uuid
  destinationLat    Float     @map("destination_lat")
  destinationLng    Float     @map("destination_lng")
  quantityAllocated Int       @default(0) @map("quantity_allocated")
  status            String    @default("pending") // pending | en_route | delivered
  priorityScore     Float     @default(0) @map("priority_score")
  estimatedArrival  DateTime? @map("estimated_arrival") @db.Timestamptz
  isLocked          Boolean   @default(false) @map("is_locked")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  isDemo            Boolean   @default(false) @map("is_demo")
  sessionId         String?   @map("session_id")

  resourceId      String        @map("resource_id") @db.Uuid
  resource        Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  disasterEventId String        @map("disaster_event_id") @db.Uuid
  disasterEvent   DisasterEvent @relation(fields: [disasterEventId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([disasterEventId])
  @@map("resource_allocations")
}

// ---------------------------------------------------------------------
// alert_logs
// ---------------------------------------------------------------------
model AlertLog {
  id               String    @id @default(uuid()) @db.Uuid
  severity         String    @default("watch")
  channel          String    @default("sms")
  message          String
  district         String?
  triggerCondition String?   @map("trigger_condition")
  isAcknowledged   Boolean   @default(false) @map("is_acknowledged")
  acknowledgedBy   String?   @map("acknowledged_by")
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz
  sentAt           DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isDemo           Boolean   @default(false) @map("is_demo")
  sessionId        String?   @map("session_id")

  disasterEventId String?        @map("disaster_event_id") @db.Uuid
  disasterEvent   DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: SetNull)

  @@index([severity, sentAt])
  @@index([district, createdAt])
  @@map("alert_logs")
}

// ---------------------------------------------------------------------
// alert_rules — declarative routing for the alert orchestration engine.
// trigger_condition e.g. 'critical_flood'; target_roles is a comma-separated
// role list; channels is a JSON array e.g. '["sms", "in_app"]'.
// ---------------------------------------------------------------------
model AlertRule {
  id               String   @id @default(uuid()) @db.Uuid
  triggerCondition String   @map("trigger_condition")
  targetRoles      String   @map("target_roles")
  channels         String
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("alert_rules")
}

// ---------------------------------------------------------------------
// alert_templates — message bodies with {variable} placeholders rendered
// by lib/alerts/template-parser.ts, e.g.
// "⚠️ {risk_level} warning for {district} at {predicted_time}."
// ---------------------------------------------------------------------
model AlertTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  messageBody String   @map("message_body")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("alert_templates")
}

// ---------------------------------------------------------------------
// emergency_documents  (pgvector vector(1536) for RAG)
// ---------------------------------------------------------------------
model EmergencyDocument {
  id               String                       @id @default(uuid()) @db.Uuid
  title            String
  docType          String                       @default("plan") @map("doc_type")
  content          String
  metadata         Json?
  embedding        Unsupported("vector(1536)")?
  embeddingVersion Int                          @default(0) @map("embedding_version")
  embeddingSource  String?                      @map("embedding_source")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  disasterEventId String?        @map("disaster_event_id") @db.Uuid
  disasterEvent   DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: SetNull)

  @@map("emergency_documents")
}

// ---------------------------------------------------------------------
// weather_data  (raw hydrology/rainfall observations)
// ---------------------------------------------------------------------
model WeatherData {
  id          String   @id @default(uuid()) @db.Uuid
  stationId   String?  @map("station_id")
  timestamp   DateTime @db.Timestamptz
  rainfallMm  Float    @map("rainfall_mm")
  riverLevelM Float?   @map("river_level_m")
  riverName   String?  @map("river_name")
  district    String?
  lat         Float
  lng         Float
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([timestamp])
  @@index([district])
  @@map("weather_data")
}

// ---------------------------------------------------------------------
// data_source  (registry of upstream ingestion endpoints)
// ---------------------------------------------------------------------
model DataSource {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  endpoint      String
  isActive      Boolean   @default(true) @map("is_active")
  lastFetchTime DateTime? @map("last_fetch_time") @db.Timestamptz
  status        String    @default("green")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("data_source")
}

// ---------------------------------------------------------------------
// evacuation_plans — one plan per village being routed to a shelter.
// route_geojson holds the GeoJSON LineString (OSRM or straight-line fallback).
// ---------------------------------------------------------------------
model EvacuationPlan {
  id                String   @id @default(uuid()) @db.Uuid
  villageName       String   @map("village_name")
  assignedShelterId String   @map("assigned_shelter_id")
  estimatedEvacuees Int      @map("estimated_evacuees")
  status            String   @default("pending") // pending | in_transit | completed
  routeGeoJson      String   @map("route_geojson")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo            Boolean  @default(false) @map("is_demo")
  sessionId         String?  @map("session_id")

  shelterId String?  @map("shelter_id") @db.Uuid
  shelter   Shelter? @relation(fields: [shelterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("evacuation_plans")
}

// ---------------------------------------------------------------------
// road_closures — points blocking evacuation routes.
// ---------------------------------------------------------------------
model RoadClosure {
  id        String   @id @default(uuid()) @db.Uuid
  lat       Float
  lng       Float
  reason    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo    Boolean  @default(false) @map("is_demo")
  sessionId String?  @map("session_id")

  @@map("road_closures")
}

// ---------------------------------------------------------------------
// push_subscriptions — Web Push (VAPID) receivers keyed to a user.
// endpoint is unique so re-subscribing upserts instead of duplicating.
// ---------------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------
// plan_feedback (Phase 11) — thumbs up/down RLHF signals on AI-generated
// emergency plans, so quality can be tracked per landmark query.
// ---------------------------------------------------------------------
model PlanFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id")
  rating    String // 'up' | 'down'
  userId    String?  @map("user_id")
  district  String?
  prompt    String? // snapshot of the user's query
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo    Boolean  @default(false) @map("is_demo")
  sessionId String?  @map("session_id")

  @@index([messageId])
  @@index([rating, createdAt])
  @@map("plan_feedback")
}

// ---------------------------------------------------------------------
// crowdsourced_reports (Phase 17) — citizen-submitted ground truth,
// the human signal that feeds verification, prediction correction and
// situational awareness. Reports arrive via social, app, or SMS, start
// `unverified`, and are promoted as responders verify true signals.
// ---------------------------------------------------------------------
model CrowdsourcedReport {
  id                 String   @id @default(uuid()) @db.Uuid
  lat                Float
  lng                Float
  reportType         String   @map("report_type") // flooding | road_blocked | shelter_needed | rescue
  source             String   @default("app") // social | app | sms
  rawText            String   @map("raw_text")
  confidenceScore    Float    @default(0.5) @map("confidence_score")
  verificationStatus String   @default("unverified") @map("verification_status") // unverified | verified | rejected
  imageUrl           String?  @map("image_url")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo             Boolean  @default(false) @map("is_demo")
  sessionId          String?  @map("session_id")

  @@index([reportType])
  @@index([verificationStatus, createdAt])
  @@map("crowdsourced_reports")
}

// ---------------------------------------------------------------------
// chat_sessions + chat_messages (Phase 11 · Persistence)
// Persists AI emergency planning conversations so history survives refresh.
// ---------------------------------------------------------------------
model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  title     String   @default("New Conversation")
  district  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  isDemo    Boolean  @default(false) @map("is_demo")
  sessionId String?  @map("session_id")

  messages ChatMessage[]

  @@index([userId])
  @@index([updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // user | assistant | tool
  content   String
  toolName  String?  @map("tool_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------
// tool_call_logs (Phase 10 · Observability)
// Persistent record of every AI tool call for cost analysis + debugging.
// ---------------------------------------------------------------------
model ToolCallLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  toolName    String   @map("tool_name")
  input       Json?
  output      Json?
  durationMs  Int      @map("duration_ms")
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([toolName])
  @@index([createdAt])
  @@map("tool_call_logs")
}

// ---------------------------------------------------------------------
// fm_stations (Phase 26 · FM Radio Emergency Broadcasting)
// Self-curated registry of Indian FM stations + their coverage polygons.
// `coverage_area` (PostGIS geography Polygon) is auto-computed by the
// fm_stations_compute_coverage trigger from lat/lng + coverage_radius_km;
// `findStationsInRadius()` (lib/fm/find-stations.ts) does the geospatial
// "which stations cover this disaster zone" lookup with a turf fallback.
// ---------------------------------------------------------------------
model FmStation {
  id                    String                                @id @default(uuid()) @db.Uuid
  name                  String
  frequency             String
  city                  String
  state                 String
  callSign              String?                               @map("call_sign")
  coverageRadiusKm      Int                                   @default(50) @map("coverage_radius_km")
  lat                   Decimal?                              @db.Decimal(10, 8)
  lng                   Decimal?                              @db.Decimal(11, 8)
  operator              String?
  type                  String                                @default("private") // private | air | community
  emergencyApiEndpoint  String?                               @map("emergency_api_endpoint")
  emergencyContactPhone String?                               @map("emergency_contact_phone")
  emailAddress          String?                               @map("email_address")
  rdsEnabled            Boolean                               @default(false) @map("rds_enabled")
  rdsApiEndpoint        String?                               @map("rds_api_endpoint")
  isActive              Boolean                               @default(true) @map("is_active")
  createdAt             DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                              @updatedAt @map("updated_at") @db.Timestamptz

  coverageArea          Unsupported("geography(Polygon, 4326)")?
  broadcastLogs         FmBroadcastLog[]

  @@index([state, city])
  @@index([type])
  @@map("fm_stations")
}

// ---------------------------------------------------------------------
// fm_broadcast_logs (Phase 4) — per-station dispatch audit trail. One row
// per strategy attempt for a CAP alert + station. Written by the FM
// dispatcher (lib/broadcast/fm-dispatcher.ts); `retry_count` tracks the
// retry budget, `status` moves sent → delivered / retrying → failed.
// ---------------------------------------------------------------------
model FmBroadcastLog {
  id             String    @id @default(uuid()) @db.Uuid
  capAlertId     String?   @map("cap_alert_id") @db.Uuid
  capAlert       CapAlert? @relation(fields: [capAlertId], references: [id], onDelete: SetNull)
  fmStationId    String?   @map("fm_station_id") @db.Uuid
  fmStation      FmStation? @relation(fields: [fmStationId], references: [id], onDelete: SetNull)
  strategy       String // cap_api | rds | ftp | email | ivr
  status         String    @default("sent") // sent | delivered | failed | retrying
  responseCode   Int?      @map("response_code")
  responseBody   String?   @map("response_body")
  broadcastTime  DateTime? @map("broadcast_time") @db.Timestamptz
  retryCount     Int       @default(0) @map("retry_count")
  testMode       Boolean   @default(false) @map("test_mode")
  // Phase 5 · IVR fallback — the Twilio CallSid for the control-room call,
  // matched by the /api/webhooks/twilio/call-status callback.
  externalRef    String?   @map("external_ref")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([capAlertId])
  @@index([fmStationId])
  @@index([status])
  @@map("fm_broadcast_logs")
}

// ---------------------------------------------------------------------
// alert_audio (Phase 26) — generated TTS alert voices. One row per
// generation; `cache_key` dedupes identical alerts for the 24 h cache.
// The dispatch pipeline (Phase 3) links dispatches to an audio record
// via `alertId`.
// ---------------------------------------------------------------------
model AlertAudio {
  id         String   @id @default(uuid()) @db.Uuid
  alertId    String?  @map("alert_id")
  language   String
  provider   String
  durationSec Float   @map("duration_sec")
  script     String
  cacheKey   String   @map("cache_key")
  audioUrl   String?  @map("audio_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([cacheKey])
  @@index([alertId])
  @@index([language])
  @@map("alert_audio")
}

// ---------------------------------------------------------------------
// cap_alerts (Phase 3) — CAP v1.2 alert audit trail. One row per CAP
// message generated for an FM broadcast. `alertId` is the CAP
// <identifier> (unique per sender); `disasterEventId` links the message
// to the triggering disaster event. cap_xml holds the full document.
// ---------------------------------------------------------------------
model CapAlert {
  id               String    @id @default(uuid()) @db.Uuid
  alertId          String    @unique @map("alert_id")
  disasterEventId  String?   @map("disaster_event_id") @db.Uuid
  disasterEvent    DisasterEvent? @relation(fields: [disasterEventId], references: [id], onDelete: SetNull)
  capXml           String    @map("cap_xml")
  capHash          String?   @map("cap_hash") // Phase 8 · SHA-256 tamper-proofing digest
  audioUrl         String?   @map("audio_url")
  language         String?
  severity         String?
  status           String    @default("pending") // pending | sent | delivered | failed
  sentAt           DateTime? @map("sent_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([disasterEventId])
  @@index([status])
  broadcastLogs       FmBroadcastLog[]
  @@map("cap_alerts")
}

// ---------------------------------------------------------------------
// audit_logs (Phase 18) — immutable trail of who did what. Written on
// every privileged admin action (role change, deactivate, config save).
// Writes are best-effort: failures are logged, never thrown.
// ---------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") // null for guest/demo-authored actions
  action    String
  resource  String
  details   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  isDemo    Boolean  @default(false) @map("is_demo")
  sessionId String?  @map("session_id")

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
